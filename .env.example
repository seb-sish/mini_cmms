# Mini-CMMS Environment Configuration

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_COMPANY_TIMEZONE=Europe/Moscow

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mini_cmms
DB_DSN=postgresql+asyncpg://postgres:postgres@postgres:5432/mini_cmms

# Redis
REDIS_URL=redis://redis:6379/0

# Security & Initial Admin
SECURITY_TOKEN_EXPIRE_HOURS=12
SECURITY_RATE_LIMIT_MAX_ATTEMPTS=5
SECURITY_RATE_LIMIT_WINDOW_SECONDS=600
SECURITY_FIRST_ADMIN_LOGIN=admin
SECURITY_FIRST_ADMIN_PASSWORD=AdminSecret123!
